generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Cada vendedor tem seu WhatsApp conectado e seus próprios contatos/campanhas
model Vendedor {
  id        String       @id @default(cuid())
  nome      String
  userId    String       @unique
  ativo     Boolean      @default(true)
  createdAt DateTime     @default(now())
  listas    ContactList[]
  campanhas Campaign[]
}

model Contact {
  id        String            @id @default(cuid())
  phone     String            @unique
  name      String?
  tags      String[]
  variables Json?             // Campos extras do CSV: {email, saldo, vencimento, ...}
  createdAt DateTime          @default(now())
  listItems ContactListItem[]
  messages  CampaignMessage[]
}

model ContactList {
  id          String            @id @default(cuid())
  name        String
  description String?
  vendedorId  String?           // Lista pertence a um vendedor específico
  createdAt   DateTime          @default(now())
  vendedor    Vendedor?         @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  items       ContactListItem[]
  campaigns   Campaign[]
}

model ContactListItem {
  id        String      @id @default(cuid())
  contactId String
  listId    String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
}

// Script = sequência de passos de mensagem
model MessageTemplate {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  steps     TemplateStep[]
  campaigns Campaign[]
  messages  CampaignMessage[]
}

model TemplateStep {
  id         String          @id @default(cuid())
  templateId String
  stepOrder  Int
  stepType   String          @default("text") // "text" | "image"
  body       String          // Text content (stepType=text) OR image caption (stepType=image)
  imageUrl   String?         // Relative path e.g. "/uploads/xxx.jpg" — only for stepType=image
  delayAfter Int             @default(60)  // Segundos até o próximo passo
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, stepOrder])
}

model Campaign {
  id                String                 @id @default(cuid())
  name              String
  vendedorId        String                 // Vendedor responsável por esta campanha
  listId            String?
  templateId        String?
  templates         Json?                  // A/B testing: [{ id: string, weight: number }]
  customMessage     String?                // Mensagem direta (quando não há script)
  scheduledAt       DateTime?              // Se definido, campanha inicia automaticamente nessa data/hora
  status            CampaignStatus         @default(DRAFT)
  minDelay          Int                    @default(10)  // segundos
  maxDelay          Int                    @default(30)  // segundos
  enableRemarketing Boolean                @default(false)
  maxSendsPerDay    Int                    @default(0)   // 0 = sem limite diário
  createdAt         DateTime               @default(now())
  vendedor      Vendedor               @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  list          ContactList?           @relation(fields: [listId], references: [id], onDelete: SetNull)
  template      MessageTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messages      CampaignMessage[]
  scheduleRules CampaignScheduleRule[]

  @@index([status, scheduledAt])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

// Janelas de envio: ex. Seg-Sex das 09:00 às 18:00, máx 100 contatos
model CampaignScheduleRule {
  id                String   @id @default(cuid())
  campaignId        String
  dayOfWeek         Int      // 0=Dom, 1=Seg, ..., 6=Sáb
  startTime         String   // "09:00"
  endTime           String   // "18:00"
  maxContacts       Int?     // null = sem limite
  maxContactsPeriod String   @default("day")  // "hour" | "day" | "week"
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// Fila de execução: um item por contato, controla o passo atual da sequência
model CampaignMessage {
  id            String        @id @default(cuid())
  campaignId    String
  contactId     String
  currentStep   Int           @default(1)
  status        MessageStatus @default(PENDING)
  nextSendAt    DateTime?     // Worker processa quando nextSendAt <= agora
  templateId    String?
  whatsappMsgId String?
  sentAt        DateTime?
  replied       Boolean   @default(false)
  repliedAt     DateTime?
  failureReason    String?
  failureCategory  String?    // "no_whatsapp" | "session_error" | "timeout" | "unknown"
  createdAt        DateTime   @default(now())
  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id])
  template      MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status, nextSendAt])
  @@index([campaignId, status])
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  COMPLETED
  SKIPPED
}

// ─── Remarketing / Follow-Up automático ───────────────────────────────────────

model RemarketingConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  enabled         Boolean  @default(false)
  maxFollowUps    Int      @default(3)
  intervalMinutes Int      @default(1440)   // Minutos entre follow-ups do MESMO lead (ex: 1440 = 24h)
  minDelaySec     Int      @default(15)     // Delay mínimo em segundos entre leads diferentes (anti-ban)
  maxDelaySec     Int      @default(45)     // Delay máximo em segundos entre leads diferentes (anti-ban)
  maxPerDay       Int      @default(0)      // 0 = sem limite diário de disparos
  allowedDays     String   @default("1,2,3,4,5")  // CSV de dias: 1=Seg…7=Dom
  windowStart     String   @default("09:00")
  windowEnd       String   @default("18:00")
  timezone        String   @default("America/Campo_Grande")
  scripts         Json     @default("[]")   // [{ templateId: string, stepLabel?: string }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RemarketingLead {
  id          String   @id @default(cuid())
  userId      String
  number      String
  name        String?
  currentStep Int      @default(1)
  nextRun     DateTime
  triggeredAt DateTime @default(now())
  status      String    @default("pending")  // pending | completed | failed | stop_by_admin
  failCount   Int       @default(0)
  lastSentAt  DateTime?
  replied     Boolean   @default(false)
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, number])
  @@index([status, nextRun])
  @@index([userId, status])
}
